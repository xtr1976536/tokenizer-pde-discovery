+"""Interrupt real orchestration at a durable boundary and compare replay."""
+from types import SimpleNamespace
+import copy
+import numpy as np
+import pytest
+import torch
+from math_tokenizer.eqgpt.author import seed_all, tensor_hash, DICTIONARY
+from math_tokenizer.eqgpt.tokenizer_adapters import Adapter
+from math_tokenizer.eqgpt import study3_search as runtime
+
+
+class TinyModel(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.logits = torch.nn.Parameter(torch.randn(57))
+        self.decoder = SimpleNamespace(pos_emb=SimpleNamespace(num_embeddings=8))
+
+    def forward(self, ids):
+        return torch.nn.functional.dropout(self.logits.expand(ids.numel(), -1),
+                                            p=.15, training=self.training), None
+
+
+class FeedbackEvaluator:
+    def __init__(self, *args, **kwargs):
+        self.env = runtime.training_namespace('cpu')
+        # Selection uses the author's numerical namespace.
+        from math_tokenizer.eqgpt.author import numerical_namespace
+        self.env.update(numerical_namespace('cpu', 'Wave_equation'))
+        self.mask = torch.ones(57)
+        self.mask_values = self.mask.tolist()
+        self.cache = {}
+        self.reward_cache = {}
+        self.reward_cache_hits = self.author_reward_calls = 0
+
+    def evaluate(self, row):
+        row = copy.deepcopy(row)
+        w = DICTIONARY['word2id']
+        row.update(status='evaluated', gre=[5, w['ut'], 2, w['uxx'], 1],
+                   reward=float(.8 + np.random.random() * .1))
+        self.cache['numeric'] = np.asarray([np.random.random()], dtype=np.float64)
+        self.mask[6] = 0
+        self.mask_values = self.mask.tolist()
+        self.reward_cache[tuple(row['gre'])] = row['reward']
+        self.author_reward_calls += 1
+        return row
+
+
+@pytest.mark.parametrize('boundary', ['candidate', 'cycle'])
+def test_search_restart_matches_uninterrupted(tmp_path, monkeypatch, boundary):
+    monkeypatch.setattr(runtime, 'RewardEvaluator', FeedbackEvaluator)
+    monkeypatch.setattr(runtime, 'diagnostics', lambda *a, **kw: {})
+    seed_all(525)
+    initial = TinyModel().state_dict()
+    net = torch.nn.Linear(1, 1)
+    database = torch.zeros(1, 1)
+    settings = dict(seed=525, cycles=2, attempts=27, positions=8, search_limit=5,
+                    continuation_lr=1e-5, continuation_epochs=2, epi=.2)
+
+    def run(folder):
+        seed_all(525)
+        model = TinyModel()
+        model.load_state_dict(initial)
+        report = runtime.search(model, Adapter('eqgpt'), net, database, 'Wave_equation',
+                                folder, 'cpu', reference=True, settings=settings)
+        return report, tensor_hash(model.state_dict())
+
+    expected, expected_hash = run(tmp_path / 'uninterrupted')
+    save = runtime.atomic_save
+    interrupted = False
+
+    def fail_after_save(value, path):
+        nonlocal interrupted
+        save(value, path)
+        condition = (path.name == 'attempt_progress.pt' and len(value['evaluated']) == 25
+                     if boundary == 'candidate' else path.name == 'search_progress.pt' and value['cycle'] == 1)
+        if condition and not interrupted:
+            interrupted = True
+            raise InterruptedError('simulated process interruption after committed checkpoint')
+
+    monkeypatch.setattr(runtime, 'atomic_save', fail_after_save)
+    with pytest.raises(InterruptedError):
+        run(tmp_path / 'resumed')
+    monkeypatch.setattr(runtime, 'atomic_save', save)
+    actual, actual_hash = run(tmp_path / 'resumed')
+    assert interrupted and actual_hash == expected_hash
+    for field in ('attempts', 'history', 'checkpoints', 'author_reward_calls', 'score_cache_hits'):
+        assert actual[field] == expected[field]
+    # Reenter after search completion (e.g. a crash before the case marker).
+    repeated, repeated_hash = run(tmp_path / 'resumed')
+    assert repeated_hash == expected_hash and repeated['attempts'] == expected['attempts']
+
+
+def test_pretrain_restart_matches_uninterrupted(tmp_path, monkeypatch):
+    from math_tokenizer.eqgpt import round1_runtime as training
+    seed_all(525)
+    initial = TinyModel().state_dict()
+    sequences = [[5, 6, 2, 7, 1], [5, 8, 3, 9, 1]]
+
+    def run(folder):
+        model = TinyModel(); model.load_state_dict(initial)
+        report = training.train_round1(model, sequences, folder, 'cpu', 525, epochs_override=3)
+        return report, tensor_hash(model.state_dict())
+
+    expected, expected_hash = run(tmp_path / 'uninterrupted')
+    save = training.atomic_save
+
+    def fail_after_save(value, path):
+        save(value, path)
+        if path.name == 'training_progress.pt' and value['epoch'] == 1:
+            raise InterruptedError('simulated interruption after epoch one')
+
+    monkeypatch.setattr(training, 'atomic_save', fail_after_save)
+    with pytest.raises(InterruptedError):run(tmp_path / 'resumed')
+    monkeypatch.setattr(training, 'atomic_save', save)
+    actual, actual_hash = run(tmp_path / 'resumed')
+    assert actual_hash == expected_hash
+    assert [r['loss'] for r in actual['history']] == [r['loss'] for r in expected['history']]
