+"""Safe, local restart state for the registered experiment."""
+import random
+import numpy as np
+import torch
+
+
+def rng_state(device):
+    kind, values, position, gaussian, cached = np.random.get_state()
+    return dict(python=random.getstate(), numpy=(kind, values.tolist(), position, gaussian, cached),
+                cpu=torch.get_rng_state(),
+                cuda=torch.cuda.get_rng_state_all() if str(device) == 'cuda' else [])
+
+
+def restore_rng(state, device):
+    random.setstate(state['python'])
+    kind, values, position, gaussian, cached = state['numpy']
+    np.random.set_state((kind, np.asarray(values, dtype=np.uint32), position, gaussian, cached))
+    torch.set_rng_state(state['cpu'])
+    if str(device) == 'cuda':
+        torch.cuda.set_rng_state_all(state['cuda'])
+
+
+def evaluator_state(evaluator):
+    return dict(cache={k: torch.from_numpy(np.asarray(v).copy()) for k, v in evaluator.cache.items()},
+                mask=evaluator.mask.detach().cpu(), reward_cache=evaluator.reward_cache,
+                reward_cache_hits=evaluator.reward_cache_hits, author_reward_calls=evaluator.author_reward_calls)
+
+
+def restore_evaluator(evaluator, state, device):
+    evaluator.cache = {k: v.numpy().copy() for k, v in state['cache'].items()}
+    evaluator.mask = state['mask'].to(device)
+    evaluator.mask_values = evaluator.mask.detach().cpu().tolist()
+    evaluator.reward_cache = state['reward_cache']
+    evaluator.reward_cache_hits = state['reward_cache_hits']
+    evaluator.author_reward_calls = state['author_reward_calls']
